
from transformers import pipeline

generator = pipeline("text-generation", model="EleutherAI/gpt-neo-125M")

prompt = """
Write a complete Python function named add_numbers(a, b).
The function must return a + b.
Python code:
"""

result = generator(
    prompt,
    max_new_tokens=60,
    do_sample=False,
    pad_token_id=50256
)

code = result[0]['generated_text']

print("Generated Code:")
print(code)


